    "/v1/admin/properties/{id}/reaggregate": {
      "post": {
        "tags": [
          "stat"
        ],
        "summary": "`POST /v1/admin/properties/{id}/reaggregate`\nDelete and rebuild the property's day-granularity `metrics` rollups over\na raw-events window (stat README §7). v1 reaggregates from `stat.events`\nONLY — a window reaching past the property's retention horizon is a 400\n(the spilled raw data lives in Storage archives; per stat DESIGN §4.3.6\nthe archive spill is the source-of-truth boundary and the Storage-archive\nreplay path is out of scope for this endpoint). The recomputation shares the\nbackground rollup's SQL via\n`crate::worker::rollups::reaggregate_property`.",
        "operationId": "property.reaggregate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Property ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env (required)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReaggregateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Rollups rebuilt over the window"
          },
          "400": {
            "description": "Invalid window, window beyond the retention horizon, or property not in env"
          },
          "403": {
            "description": "Missing stat:admin scope"
          },
          "404": {
            "description": "Property not found"
          }
        },
        "security": [
          {
            "sentin8:stat:admin": []
          }
        ]
      }
    },
