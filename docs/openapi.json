    "/v1/admin/properties/{id}/alert-rules": {
      "get": {
        "tags": [
          "stat"
        ],
        "summary": "`GET /v1/admin/properties/{id}/alert-rules`",
        "operationId": "alert_rule.list",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Property ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env (required)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rules for the property",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlertRule"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing stat:admin scope"
          }
        },
        "security": [
          {
            "sentin8:stat:admin": []
          }
        ]
      },
      "post": {
        "tags": [
          "stat"
        ],
        "summary": "`POST /v1/admin/properties/{id}/alert-rules`\nCreate a per-property custom alert rule (stat README §7). The request\nis validated against the known rule types, comparators, and metric\nvocabulary (400 on unknown); the property must exist in the target\nenv (404). The INSERT runs in one explicit transaction with the RLS\ncontext set on the same connection (stat DESIGN §5).",
        "operationId": "alert_rule.create",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Property ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "target_env_id",
            "in": "query",
            "description": "Target env (required)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlertRuleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Rule created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRule"
                }
              }
            }
          },
          "400": {
            "description": "Unknown rule_type, comparator, or metric_name; invalid threshold/window"
          },
          "403": {
            "description": "Missing stat:admin scope"
          },
          "404": {
            "description": "Property not found in env"
          }
        },
        "security": [
          {
            "sentin8:stat:admin": []
          }
        ]
      }
    },
