          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "updated time."
          }
        }
      },
      "ReaggregateRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/admin/properties/{id}/reaggregate` — the\nraw-events window to rebuild. Both fields accept RFC 3339 timestamps;\nomitted fields default per `parse_reaggregate_window` (full omission =\nlast 30 days).\nThe reaggregaterequest type.",
        "properties": {
          "from": {
            "type": [
              "string",
              "null"
