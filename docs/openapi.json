  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "description": "The account type.",
        "required": [
          "id",
          "env_id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "created time."
          },
          "env_id": {
            "type": "string",
            "format": "uuid",
            "description": "env identifier."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier."
          },
          "name": {
            "type": "string",
            "description": "The name."
          }
        }
      },
      "AlertRule": {
        "type": "object",
        "description": "A per-property custom alert rule (`stat.alert_rules`, stat README §7).\nThe alertrule type.",
        "required": [
          "id",
          "env_id",
          "property_id",
          "name",
          "rule_type",
          "metric_name",
          "comparator",
          "threshold",
          "window_hours",
          "min_sample",
          "enabled",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "comparator": {
            "type": "string",
            "description": "Comparator — `gt` | `gte` | `lt` | `lte`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "created time."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the rule evaluates."
          },
          "env_id": {
            "type": "string",
            "format": "uuid",
            "description": "env identifier."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier."
          },
          "metric_name": {
            "type": "string",
            "description": "Metric vocabulary key (`events.count`, `conversions.count`,\n`metric:{name}`)."
          },
          "min_sample": {
            "type": "integer",
            "format": "int32",
            "description": "Noise floor — the rule never evaluates below it."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "property_id": {
            "type": "string",
            "format": "uuid",
            "description": "Watched property identifier."
          },
          "rule_type": {
            "type": "string",
            "description": "Rule type — `threshold` (metric value vs threshold) or `anomaly`\n(moving-average deviation factor over the window)."
          },
          "threshold": {
            "type": "number",
            "format": "double",
            "description": "Comparison threshold (metric value or deviation factor)."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "updated time."
          },
          "window_hours": {
            "type": "integer",
            "format": "int32",
            "description": "Moving-average lookback in hours (`anomaly` rules)."
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "description": "Request body for createaccount.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name."
          }
        }
      },
      "CreateAlertRuleRequest": {
        "type": "object",
        "description": "Request body for `POST /v1/admin/properties/{id}/alert-rules`.\nRequest body for createalertrule.",
        "required": [
          "name",
          "rule_type",
          "metric_name",
          "comparator",
          "threshold"
        ],
        "properties": {
          "comparator": {
            "type": "string",
            "description": "`gt` | `gte` | `lt` | `lte`."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the rule evaluates."
          },
          "metric_name": {
            "type": "string",
            "description": "Metric vocabulary key (`events.count`, `conversions.count`,\n`metric:{name}`)."
          },
          "min_sample": {
            "type": "integer",
            "format": "int32",
            "description": "Noise floor — the rule never evaluates below it."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "rule_type": {
            "type": "string",
            "description": "`threshold` or `anomaly`."
          },
          "threshold": {
            "type": "number",
            "format": "double",
            "description": "Comparison threshold (metric value, or deviation factor for\n`anomaly` — e.g. `3.0` = current exceeds 3× the baseline)."
          },
          "window_hours": {
            "type": "integer",
            "format": "int32",
            "description": "Moving-average lookback in hours (`anomaly` rules)."
          }
        }
      },
      "CreatePropertyRequest": {
        "type": "object",
        "description": "Request body for createproperty.",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "account_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "account identifier."
          },
          "name": {
            "type": "string",
            "description": "The name."
          },
          "slug": {
            "type": "string",
            "description": "The slug."
          }
        }
      },
      "Property": {
        "type": "object",
        "description": "The property type.",
        "required": [
          "id",
          "env_id",
          "name",
          "slug",
          "timezone",
          "session_timeout_minutes",
          "retention_days",
          "bot_filter_enabled",
          "pii_deny_list",
          "status",
          "created_at",
          "updated_at"
