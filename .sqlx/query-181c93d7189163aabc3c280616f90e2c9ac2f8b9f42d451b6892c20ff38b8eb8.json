  "query": "SELECT id, event_type, event_name, client_id, client_type,\n                      page_url, page_title, referrer, screen_name,\n                      subject_id, session_id, timestamp, props, metrics\n               FROM events\n               WHERE property_id = $1\n                 AND created_at < $2\n                 AND archived = false\n               LIMIT 1000",
